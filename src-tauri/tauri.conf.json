{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CodeNest",
  "mainBinaryName": "CodeNest",
  "version": "1.1.2",
  "identifier": "com.midnightcrowing.codenest",
  "build": {
    "beforeDevCommand": "pnpm dev:vue",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "pnpm build:vue",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeNest",
        "visible": false,
        "width": 1200,
        "height": 650,
        "minWidth": 800,
        "minHeight": 650,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFERUM4M0I4NjYwMkYxNApSV1FVTDJDR084amVDcUg4bG5nR2FwQ0MvQ21sdTgwbTlQOWR5RDZEcnVtdXNBbVhTcUpERUEyQQo=",
      "endpoints": [
        "https://github.com/MidnightCrowing/CodeNest/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../src/assets/app-icon.ico",
      "../src/assets/app-icon.icns",
      "../src/assets/app-icon.png"
    ],
    "resources": {
      "../LICENSE.txt": "LICENSE.txt"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
